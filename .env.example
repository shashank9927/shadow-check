NODE_ENV=development
DATABASE_URL=postgresql://shadowcheck:shadowcheck@localhost:5432/shadowcheck?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
REPLAY_CONCURRENCY=5
DEFAULT_REQUEST_TIMEOUT_MS=5000
MAX_RESPONSE_BODY_BYTES=1048576
MAX_IMPORT_FILE_BYTES=5242880
ALLOW_PRIVATE_NETWORK_TARGETS=true
REPLAY_RESULT_RETENTION_DAYS=30
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:4000
