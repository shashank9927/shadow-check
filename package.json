{
  "name": "shadowcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently --names api,worker,web,baseline,candidate \"pnpm --filter @shadowcheck/api dev\" \"pnpm --filter @shadowcheck/worker dev\" \"pnpm --filter @shadowcheck/web dev\" \"pnpm --filter @shadowcheck/fixtures dev:baseline\" \"pnpm --filter @shadowcheck/fixtures dev:candidate\"",
    "build": "pnpm -r --filter @shadowcheck/contracts --filter @shadowcheck/comparison --filter @shadowcheck/redaction --filter @shadowcheck/database --filter @shadowcheck/shared --filter @shadowcheck/api --filter @shadowcheck/worker --filter @shadowcheck/cli --filter @shadowcheck/fixtures build && pnpm --filter @shadowcheck/web build",
    "typecheck": "pnpm -r --filter @shadowcheck/contracts --filter @shadowcheck/comparison --filter @shadowcheck/redaction --filter @shadowcheck/database --filter @shadowcheck/shared --filter @shadowcheck/api --filter @shadowcheck/worker --filter @shadowcheck/cli --filter @shadowcheck/fixtures typecheck && pnpm --filter @shadowcheck/web typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "demo": "docker compose --profile demo up --build",
    "cleanup": "tsx apps/worker/src/cleanup.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.6",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "prisma": "^6.14.0",
    "vitest": "^4.0.10"
  }
}
