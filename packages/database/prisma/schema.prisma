generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnvironmentType {
  BASELINE
  CANDIDATE
}
enum RedactionAction {
  REDACT
  REMOVE
}
enum RunStatus {
  CREATED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
enum ExecutionResult {
  PASS
  WARNING
  REGRESSION
  ERROR
}
enum DifferenceType {
  FIELD_ADDED
  FIELD_REMOVED
  VALUE_CHANGED
  TYPE_CHANGED
  ARRAY_LENGTH_CHANGED
  STATUS_CHANGED
  HEADER_CHANGED
  LATENCY_REGRESSION
  OPENAPI_VIOLATION
}
enum Severity {
  INFO
  WARNING
  BREAKING
}

model Project {
  id                  String             @id @default(cuid())
  name                String
  description         String?
  maxConcurrency      Int                @default(5)
  requestsPerSecond   Int?
  allowWriteMethods   Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  environments        Environment[]
  trafficRequests     TrafficRequest[]
  redactionRules      RedactionRule[]
  ignoreRules         IgnoreRule[]
  regressionPolicy    RegressionPolicy?
  replayRuns          ReplayRun[]
  openApiDocument     OpenApiDocument?
}

model Environment {
  id          String          @id @default(cuid())
  projectId   String
  type        EnvironmentType
  baseUrl     String
  headers     Json            @default("{}")
  timeoutMs   Int             @default(5000)
  enabled     Boolean         @default(true)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentials ApiCredential[]
  @@unique([projectId, type])
}

model ApiCredential {
  id               String      @id @default(cuid())
  environmentId    String
  headerName       String
  encryptedValue   String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  environment      Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  @@unique([environmentId, headerName])
}

model TrafficRequest {
  id          String    @id @default(cuid())
  projectId   String
  name        String?
  method      String
  path        String
  headers     Json      @default("{}")
  body        Json?
  query       Json?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions  ReplayExecution[]
  @@index([projectId, createdAt])
  @@index([projectId, method, path])
}

model RedactionRule {
  id          String          @id @default(cuid())
  projectId   String
  headerName  String?
  jsonPath    String?
  action      RedactionAction @default(REDACT)
  createdAt   DateTime        @default(now())
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model IgnoreRule {
  id              String    @id @default(cuid())
  projectId       String
  jsonPath        String
  endpointPattern String?
  createdAt       DateTime  @default(now())
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model RegressionPolicy {
  id                      String   @id @default(cuid())
  projectId               String   @unique
  failOnStatusChange      Boolean  @default(true)
  failOnRemovedFields     Boolean  @default(true)
  failOnTypeChange        Boolean  @default(true)
  latencyWarningPercent   Float    @default(20)
  latencyFailurePercent   Float    @default(50)
  latencyMinimumMs        Int      @default(100)
  selectedResponseHeaders Json     @default("[]")
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ReplayRun {
  id                 String      @id @default(cuid())
  projectId          String
  status             RunStatus   @default(CREATED)
  totalRequests      Int         @default(0)
  completedRequests  Int         @default(0)
  passed             Int         @default(0)
  warnings           Int         @default(0)
  regressions        Int         @default(0)
  errors             Int         @default(0)
  createdAt          DateTime    @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions         ReplayExecution[]
  @@index([projectId, createdAt])
}

model ReplayExecution {
  id                       String          @id @default(cuid())
  runId                    String
  trafficRequestId         String
  result                   ExecutionResult
  baselineStatusCode       Int?
  candidateStatusCode      Int?
  baselineDurationMs       Int?
  candidateDurationMs      Int?
  baselineContentType      String?
  candidateContentType     String?
  baselineHeaders          Json            @default("{}")
  candidateHeaders         Json            @default("{}")
  baselineBody             Json?
  candidateBody            Json?
  baselineRawBody          String?
  candidateRawBody         String?
  baselineTruncated        Boolean         @default(false)
  candidateTruncated       Boolean         @default(false)
  errorCode                String?
  createdAt                DateTime        @default(now())
  completedAt              DateTime?
  run                      ReplayRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  trafficRequest           TrafficRequest  @relation(fields: [trafficRequestId], references: [id], onDelete: Cascade)
  differences              ComparisonDifference[]
  @@unique([runId, trafficRequestId])
  @@index([runId, result])
}

model ComparisonDifference {
  id              String          @id @default(cuid())
  executionId     String
  path            String
  type            DifferenceType
  severity        Severity
  baselineValue   Json?
  candidateValue  Json?
  message         String
  execution       ReplayExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  @@index([executionId, severity])
  @@index([type])
}

model OpenApiDocument {
  id          String   @id @default(cuid())
  projectId   String   @unique
  format      String
  document    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
